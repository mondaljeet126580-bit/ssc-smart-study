# Delta API credentials
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_API_KEY=replace_me
DELTA_API_SECRET=replace_me

# Remote MCP access token. Keep this secret.
MCP_ACCESS_TOKEN=replace_me_with_a_long_random_token

# Live trading is OFF by default.
ENABLE_LIVE_TRADING=false

# Optional
DELTA_USER_AGENT=jeet-delta-mcp/1.0
DELTA_HTTP_TIMEOUT=30
